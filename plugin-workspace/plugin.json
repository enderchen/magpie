{
  "main": "index.html",
  "logo": "magpie-logo.png",
  "preload": "preload.js",
  "features": [
    {
      "code": "magpie",
      "explain": "纸鹊 Magpie · 管理你的纸鹊 Magpie文件（登录、搜索、上传、预览、分享）",
      "cmds": [
        "纸鹊 Magpie",
        "magpie"
      ]
    },
    {
      "code": "magpie-upload",
      "explain": "拖拽上传到纸鹊 Magpie · 生成分享链接",
      "cmds": [
        {
          "type": "files",
          "match": {
            "fileType": [
              "html",
              "htm",
              "md",
              "markdown",
              "zip"
            ]
          },
          "label": "上传到纸鹊 Magpie"
        }
      ]
    }
  ],
  "platform": [
    "darwin",
    "win32",
    "linux"
  ],
  "description": "纸鹊 Magpie uTools 插件：登录纸鹊 Magpie服务器，在 uTools 内直接管理你的 HTML/Markdown 文件——搜索、上传、预览、分享、版本历史、标签分类。",
  "version": "1.6.7",
  "author": "enderchen",
  "homepage": "https://github.com/enderchen/magpie"
}
